package mediflow.indexing;

class AVLNode {
    int key;
    AVLNode left, right;
    int height = 1;

    AVLNode(int key) { 
        this.key = key; 
    }
}

public class PatientIndexer {

    static int height(AVLNode n) { 
        return n == null ? 0 : n.height; 
    }

    static int balance(AVLNode n) { 
        return n == null ? 0 : height(n.left) - height(n.right); 
    }

    static void updateHeight(AVLNode n) {
        if (n != null) {
            n.height = 1 + Math.max(height(n.left), height(n.right));
        }
    }

    // TODO 1: Perform a right rotation around y
    static AVLNode rotateRight(AVLNode y) {
        AVLNode x = y.left;
        AVLNode T2 = x.right;

        x.right = y;
        y.left = T2;

        updateHeight(y);
        updateHeight(x);

        return x; 
    }

    // TODO 2: Perform a left rotation around x
    static AVLNode rotateLeft(AVLNode x) {
        AVLNode y = x.right;
        AVLNode T2 = y.left;

        y.left = x;
        x.right = T2;

        updateHeight(x);
        updateHeight(y);

        return y; 
    }

    // TODO 3: Standard BST insert + AVL rebalancing
    static AVLNode insert(AVLNode node, int key) {
        if (node == null) {
            return new AVLNode(key);
        }

        if (key < node.key) {
            node.left = insert(node.left, key);
        } else if (key > node.key) {
            node.right = insert(node.right, key);
        } else {
            return node; // Deduplicate existing Patient-IDs
        }

        updateHeight(node);
        int balance = balance(node);

        // Case 1: Left Left (LL)
        if (balance > 1 && key < node.left.key) {
            return rotateRight(node);
        }

        // Case 2: Right Right (RR)
        if (balance < -1 && key > node.right.key) {
            return rotateLeft(node);
        }

        // Case 3: Left Right (LR)
        if (balance > 1 && key > node.left.key) {
            node.left = rotateLeft(node.left);
            return rotateRight(node);
        }

        // Case 4: Right Left (RL)
        if (balance < -1 && key < node.right.key) {
            node.right = rotateRight(node.right);
            return rotateLeft(node);
        }

        return node;
    }

    public static void main(String[] args) {
        int[] appointments = {28, 38, 35, 48, 45, 58, 68, 65, 78, 75, 88, 85, 98};
        AVLNode root = null;
        
        for (int id : appointments) {
            root = insert(root, id);
        }
        System.out.println("AVL Tree indexing successfully built. Root node is: " + root.key);
    }
}
